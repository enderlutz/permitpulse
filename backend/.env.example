# Database
# Local SQLite (default if unset): sqlite:///./permit_pulse.db
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./permit_pulse.db

# Anthropic (for AI Weekly Digest widget)
ANTHROPIC_API_KEY=

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Census Geocoder (no key required, but rate-limited)
GEOCODER_BATCH_SIZE=1000
